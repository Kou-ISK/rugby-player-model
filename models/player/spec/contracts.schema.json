{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rugby-player-model.local/schema/player-v1",
  "$defs": {
    "Vec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "z"
      ]
    },
    "Body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "z"
          ]
        },
        "yaw": {
          "type": "number"
        },
        "headYaw": {
          "type": "number",
          "minimum": -2.4,
          "maximum": 2.4
        },
        "eyeHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "hasBall": {
          "type": "boolean"
        },
        "motor": {
          "$ref": "#/$defs/Motor"
        }
      },
      "required": [
        "position",
        "yaw",
        "headYaw",
        "eyeHeight",
        "hasBall"
      ]
    },
    "Percept": {
      "oneOf": [
        {
          "$ref": "#/$defs/PerceptV1"
        },
        {
          "$ref": "#/$defs/PerceptV2"
        }
      ]
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSpeed": {
              "type": "number",
              "minimum": 0,
              "maximum": 12
            },
            "passRange": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            }
          },
          "required": [
            "maxSpeed",
            "passRange"
          ]
        },
        "selfEstimate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passReliability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "passReliability"
          ]
        },
        "preference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "carry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pass": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "support": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "carry",
            "pass",
            "support"
          ]
        },
        "tactics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredAction": {
              "enum": [
                "scan",
                "hold",
                "carry",
                "pass",
                "support",
                "evade",
                "defend",
                "receive",
                "tackle"
              ]
            },
            "adherence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "preferredAction",
            "adherence"
          ]
        }
      },
      "required": [
        "ability",
        "selfEstimate",
        "preference",
        "tactics"
      ]
    },
    "RulesA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scanBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "carryBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "passBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "memoryHalfLife": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contextRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextRule"
          },
          "maxItems": 32
        },
        "mechanisms": {
          "$ref": "#/$defs/Mechanisms"
        }
      },
      "required": [
        "version",
        "scanBias",
        "carryBias",
        "passBias",
        "memoryHalfLife",
        "minimumConfidence"
      ]
    },
    "PatchA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scanBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "carryBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "passBias": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "memoryHalfLife": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60
        },
        "minimumConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contextRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextRule"
          },
          "maxItems": 32
        },
        "mechanisms": {
          "$ref": "#/$defs/Mechanisms"
        }
      },
      "required": []
    },
    "Memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "episodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Percept"
          },
          "maxItems": 128
        },
        "lastTime": {
          "type": "number",
          "minimum": 0
        },
        "intent": {
          "$ref": "#/$defs/LoopPlan"
        }
      },
      "required": [
        "episodes",
        "lastTime"
      ]
    },
    "Bundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/BundleV1"
        },
        {
          "$ref": "#/$defs/BundleV2"
        },
        {
          "$ref": "#/$defs/BundleV3"
        }
      ]
    },
    "BodyCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "locomotion",
            "headYaw",
            "gaze",
            "voice",
            "pass",
            "jointPose",
            "muscleEffort",
            "posture",
            "call",
            "heading",
            "tackle"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "channel",
        "status",
        "value"
      ]
    },
    "Belief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "kind": {
          "enum": [
            "player",
            "ball",
            "call"
          ]
        },
        "relation": {
          "enum": [
            "teammate",
            "opponent",
            "neutral"
          ]
        },
        "modality": {
          "enum": [
            "vision",
            "audio"
          ]
        },
        "observedAt": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "z"
          ]
        },
        "bearing": {
          "type": "number"
        },
        "cue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "currentConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "age": {
          "type": "number",
          "minimum": 0
        },
        "uncertaintyRadius": {
          "type": "number",
          "minimum": 0
        },
        "observerYaw": {
          "type": "number"
        },
        "evidenceVersion": {
          "const": 2
        },
        "bodyOrientation": {
          "$ref": "#/$defs/OrientationEvidence"
        },
        "ballControl": {
          "$ref": "#/$defs/BallControlEvidence"
        }
      },
      "required": [
        "id",
        "entityId",
        "kind",
        "relation",
        "modality",
        "observedAt",
        "confidence",
        "currentConfidence",
        "age",
        "uncertaintyRadius"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "bodyOrientation"
                ]
              },
              {
                "required": [
                  "ballControl"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "evidenceVersion"
            ],
            "properties": {
              "kind": {
                "const": "player"
              },
              "modality": {
                "const": "vision"
              },
              "relation": {
                "enum": [
                  "teammate",
                  "opponent"
                ]
              }
            }
          }
        }
      ]
    },
    "Evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "scan",
            "hold",
            "carry",
            "pass",
            "support",
            "evade",
            "defend",
            "receive",
            "tackle"
          ]
        },
        "score": {
          "type": "number"
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "score",
        "allowed",
        "reason"
      ]
    },
    "Trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensation": {
          "$ref": "#/$defs/Bundle"
        },
        "attention": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workingMemory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Belief"
          }
        },
        "longTermMemory": {
          "$ref": "#/$defs/Memory"
        },
        "beliefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Belief"
          }
        },
        "predictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entityId": {
                "type": "string",
                "minLength": 1
              },
              "basisObservedAt": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "$ref": "#/$defs/Vec"
              },
              "uncertaintyRadius": {
                "type": "number",
                "minimum": 0
              },
              "method": {
                "const": "last-observation"
              }
            },
            "required": [
              "entityId",
              "basisObservedAt",
              "uncertaintyRadius",
              "method"
            ]
          }
        },
        "evaluation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evaluation"
          }
        },
        "intention": {
          "$ref": "#/$defs/Evaluation"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BodyCommand"
          }
        },
        "rulesVersion": {
          "type": "string",
          "minLength": 1
        },
        "modelRevision": {
          "enum": [
            "cognition-0.2",
            "cognition-0.3",
            "cognition-h-wm-1-v1",
            "cognition-orientation-phase-v1",
            "cognition-loop-v1"
          ]
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uncertainThreat": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "informationValue": {
              "type": "number",
              "minimum": 0
            },
            "scanTarget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "headYaw": {
                  "type": "number",
                  "minimum": -2.4,
                  "maximum": 2.4
                },
                "observedAt": {
                  "type": "number",
                  "minimum": 0
                },
                "modality": {
                  "enum": [
                    "vision",
                    "audio"
                  ]
                }
              },
              "required": [
                "sourceId",
                "headYaw",
                "observedAt",
                "modality"
              ]
            }
          },
          "required": [
            "uncertainThreat",
            "informationValue"
          ]
        },
        "appliedRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "action": {
                "enum": [
                  "scan",
                  "hold",
                  "carry",
                  "pass",
                  "support",
                  "evade",
                  "defend",
                  "receive",
                  "tackle"
                ]
              },
              "weight": {
                "type": "number"
              },
              "call": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "action",
              "weight"
            ]
          }
        },
        "traceVersion": {
          "enum": [
            2,
            3,
            4
          ]
        },
        "deliberation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "executionMode": {
              "$ref": "#/$defs/ExecutionMode"
            },
            "encodingPolicy": {
              "const": "salience-top-4-legacy-v1"
            },
            "retentionPolicy": {
              "const": "30s-last128-legacy-v1"
            },
            "retrievalPolicy": {
              "const": "latest-entity-modality-decay-legacy-v1"
            },
            "encoded": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Percept"
              },
              "minItems": 0,
              "maxItems": 4
            },
            "retrieved": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Belief"
              },
              "minItems": 0,
              "maxItems": 128
            },
            "ranked": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Belief"
              },
              "minItems": 0,
              "maxItems": 128
            },
            "selected": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Belief"
              },
              "minItems": 0,
              "maxItems": 128
            },
            "selection": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "observedAt": {
                    "type": "number"
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 128
                  },
                  "included": {
                    "type": "boolean"
                  },
                  "reason": {
                    "enum": [
                      "within-capacity",
                      "capacity-exceeded"
                    ]
                  }
                },
                "required": [
                  "sourceId",
                  "observedAt",
                  "rank",
                  "included",
                  "reason"
                ]
              },
              "minItems": 0,
              "maxItems": 128
            },
            "consumers": {
              "const": [
                "receiver-comparison",
                "receiver-selection",
                "pass-eligibility",
                "pass-explanation"
              ]
            },
            "unconstrained": {
              "const": [
                "retained-evidence-risk-orienting",
                "fresh-no-fresh-predicates"
              ]
            }
          },
          "required": [
            "executionMode",
            "encodingPolicy",
            "retentionPolicy",
            "retrievalPolicy",
            "encoded",
            "retrieved",
            "ranked",
            "selected",
            "selection",
            "consumers",
            "unconstrained"
          ]
        },
        "situation": {
          "$ref": "#/$defs/Situation"
        },
        "loop": {
          "$ref": "#/$defs/LoopTrace"
        }
      },
      "required": [
        "sensation",
        "attention",
        "workingMemory",
        "longTermMemory",
        "beliefs",
        "predictions",
        "evaluation",
        "intention",
        "output",
        "rulesVersion",
        "modelRevision",
        "assessment"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "modelRevision": {
                "const": "cognition-loop-v1"
              }
            }
          },
          "then": {
            "required": [
              "traceVersion",
              "loop",
              "situation"
            ],
            "properties": {
              "traceVersion": {
                "const": 4
              },
              "sensation": {
                "$ref": "#/$defs/BundleV3"
              }
            }
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "modelRevision": {
                      "const": "cognition-orientation-phase-v1"
                    }
                  }
                },
                "then": {
                  "required": [
                    "traceVersion",
                    "situation",
                    "appliedRules"
                  ],
                  "properties": {
                    "traceVersion": {
                      "const": 3
                    },
                    "sensation": {
                      "$ref": "#/$defs/BundleV2"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "sensation": {
                      "$ref": "#/$defs/BundleV1"
                    }
                  },
                  "not": {
                    "required": [
                      "situation"
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "modelRevision": {
                            "const": "cognition-h-wm-1-v1"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "traceVersion",
                          "deliberation",
                          "appliedRules"
                        ],
                        "properties": {
                          "traceVersion": {
                            "const": 2
                          }
                        }
                      },
                      "else": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "traceVersion"
                              ]
                            },
                            {
                              "required": [
                                "deliberation"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "not": {
              "required": [
                "loop"
              ]
            }
          }
        }
      ]
    },
    "ContextRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "possession": {
              "enum": [
                "any",
                "has-ball",
                "no-ball"
              ]
            },
            "evidence": {
              "enum": [
                "no-fresh-receiver",
                "fresh-receiver",
                "stale-player",
                "heard-call",
                "missing-player-vision",
                "observed-ball"
              ]
            },
            "unlessCloseThreat": {
              "type": "boolean"
            }
          },
          "required": [
            "possession",
            "evidence",
            "unlessCloseThreat"
          ]
        },
        "action": {
          "enum": [
            "scan",
            "hold",
            "carry",
            "pass",
            "support",
            "evade",
            "defend",
            "receive",
            "tackle"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        },
        "call": {
          "enum": [
            "support-call",
            "warning-call"
          ]
        }
      },
      "required": [
        "id",
        "when",
        "action",
        "weight"
      ]
    },
    "ObservationEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "trigger": {
          "enum": [
            "initial",
            "head-turn",
            "body-turn",
            "step",
            "configuration",
            "restore"
          ]
        },
        "bundle": {
          "$ref": "#/$defs/Bundle"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "rulesA": {
          "$ref": "#/$defs/RulesA"
        },
        "executionMode": {
          "$ref": "#/$defs/ExecutionMode"
        }
      },
      "required": [
        "sequence",
        "trigger",
        "bundle",
        "profile",
        "rulesA"
      ]
    },
    "ObservationSequence": {
      "type": "object",
      "required": [
        "initialMemory",
        "events"
      ],
      "additionalProperties": false,
      "properties": {
        "initialMemory": {
          "$ref": "#/$defs/Memory"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/ObservationEvent"
          }
        }
      }
    },
    "ExecutionMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "policyVersion"
          ],
          "properties": {
            "mode": {
              "const": "legacy"
            },
            "policyVersion": {
              "const": "legacy-ecc5c298-v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "policyVersion",
            "capacity"
          ],
          "properties": {
            "mode": {
              "const": "h-wm-1"
            },
            "policyVersion": {
              "const": "receiver-deliberation-v1"
            },
            "capacity": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "k"
                  ],
                  "properties": {
                    "kind": {
                      "const": "finite"
                    },
                    "k": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    }
                  }
