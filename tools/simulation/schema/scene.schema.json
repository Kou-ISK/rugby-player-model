{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rugby-player-model.local/schema/simulation-v1",
  "$defs": {
    "World": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene": {
          "enum": [
            "support",
            "occluded",
            "audio",
            "heldout",
            "dynamic"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "playerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "body": {
          "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Body"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "kind": {
                "enum": [
                  "player",
                  "ball"
                ]
              },
              "team": {
                "enum": [
                  "blue",
                  "red",
                  "none"
                ]
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "z"
                ]
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 2
              },
              "yaw": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "kind",
              "team",
              "position",
              "radius"
            ]
          },
          "maxItems": 128
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "z"
                ]
              },
              "cue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "position",
              "cue"
            ]
          },
          "maxItems": 128
        },
        "emittedCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0
              },
              "playerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "cue": {
                "enum": [
                  "support-call",
                  "warning-call"
                ]
              }
            },
            "required": [
              "at",
              "playerId",
              "cue"
            ]
          },
          "maxItems": 32
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scene": {
              "$ref": "#/$defs/SceneRevision"
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "required": [
            "scene",
            "tick"
          ]
        },
        "runtime": {
          "$ref": "#/$defs/MotorRuntime"
        }
      },
      "required": [
        "scene",
        "seed",
        "time",
        "playerId",
        "body",
        "entities",
        "calls"
      ]
    },
    "SceneDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneSchemaVersion": {
          "const": 3
        },
        "tickSeconds": {
          "const": 0.2
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "controlledPlayerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "team": {
                "enum": [
                  "blue",
                  "red"
                ]
              },
              "initial": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "position": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -32,
                        "maximum": 32
                      },
                      "z": {
                        "type": "number",
                        "minimum": -48,
                        "maximum": 48
                      }
                    },
                    "required": [
                      "x",
                      "z"
                    ]
                  },
                  "yaw": {
                    "type": "number",
                    "minimum": -3.141592653589793,
                    "maximum": 3.141592653589793
                  }
                },
                "required": [
                  "position",
                  "yaw"
                ]
              },
              "motion": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "controlled"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "scripted"
                      },
                      "keyframes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "tick": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 200
                            },
                            "position": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "x": {
                                  "type": "number",
                                  "minimum": -32,
                                  "maximum": 32
                                },
                                "z": {
                                  "type": "number",
                                  "minimum": -48,
                                  "maximum": 48
                                }
                              },
                              "required": [
                                "x",
                                "z"
                              ]
                            },
                            "yaw": {
                              "type": "number",
                              "minimum": -3.141592653589793,
                              "maximum": 3.141592653589793
                            }
                          },
                          "required": [
                            "tick",
                            "position",
                            "yaw"
                          ]
                        },
                        "minItems": 2,
                        "maxItems": 201
                      }
                    },
                    "required": [
                      "kind",
                      "keyframes"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "autonomous"
                      },
                      "profile": {
                        "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Profile"
                      }
                    },
                    "required": [
                      "kind",
                      "profile"
                    ]
                  }
                ]
              }
            },
            "required": [
              "id",
              "team",
              "initial",
              "motion"
            ]
          },
          "minItems": 1,
          "maxItems": 32
        },
        "ball": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "attached"
                },
                "carrierId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "kind",
                "carrierId"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "scripted"
                },
                "keyframes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tick": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 200
                      },
                      "position": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": -32,
                            "maximum": 32
                          },
                          "z": {
                            "type": "number",
                            "minimum": -48,
                            "maximum": 48
                          }
                        },
                        "required": [
                          "x",
                          "z"
                        ]
                      },
                      "yaw": {
                        "type": "number",
                        "minimum": -3.141592653589793,
                        "maximum": 3.141592653589793
                      }
                    },
                    "required": [
                      "tick",
                      "position",
                      "yaw"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 201
                }
              },
              "required": [
                "kind",
                "keyframes"
              ]
            }
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "startTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "endTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "sourceActorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "cue": {
                "enum": [
                  "support-call",
                  "warning-call"
                ]
              }
            },
            "required": [
              "startTick",
              "endTick",
              "sourceActorId",
              "cue"
            ]
          },
          "minItems": 0,
          "maxItems": 128
        },
        "ownAttackDirection": {
          "enum": [
            1,
            -1
          ]
        },
        "horizontalFovDegrees": {
          "type": "number",
          "minimum": 60,
          "maximum": 120,
          "description": "Authored horizontal camera and sensor angle; omitted means 90 degrees. Engineering condition, not a validated human peripheral-vision model."
        },
        "simulationMode": {
          "enum": [
            "kinematic",
            "motor"
          ]
        },
        "observationMode": {
          "enum": [
            "positions",
            "oriented"
          ]
        },
        "attachedBallFrame": {
          "enum": [
            "world",
            "body"
          ]
        }
      },
      "required": [
        "sceneSchemaVersion",
        "tickSeconds",
        "durationTicks",
        "controlledPlayerId",
        "actors",
        "ball",
        "calls",
        "simulationMode",
        "observationMode",
        "attachedBallFrame"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "observationMode": {
                    "const": "oriented"
                  }
                }
              },
              {
                "properties": {
                  "simulationMode": {
                    "const": "motor"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "ownAttackDirection"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "simulationMode": {
                "const": "motor"
              }
            }
          },
          "then": {
            "properties": {
              "observationMode": {
                "const": "oriented"
              },
              "attachedBallFrame": {
                "const": "body"
              }
            }
          }
        }
      ]
    },
    "SceneRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sceneId",
        "revision",
        "contentHash"
      ]
    },
    "SceneRevision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "definition": {
          "$ref": "#/$defs/SceneDefinition"
        },
        "generationSeed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "trackingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^track-[0-9a-f-]{36}$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "createdAt": {
          "type": "string"
        },
        "sourceContentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sceneId",
        "revision",
        "contentHash",
        "definition",
        "generationSeed",
        "trackingIds",
        "createdAt"
      ]
    },
    "MotorRuntime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "body": {
                "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Body"
              },
              "memory": {
                "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Memory"
              },
              "profile": {
                "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Profile"
              }
            },
            "required": [
              "id",
              "body",
              "memory",
              "profile"
            ]
          },
          "maxItems": 32
        },
        "ball": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "held",
                "flight",
                "loose"
              ]
            },
            "position": {
              "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Vec"
            },
            "velocity": {
              "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Vec"
            },
            "carrierId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "releasedAt": {
              "type": "number"
            },
            "pending": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "at": {
                  "type": "number"
                },
                "actorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "target": {
                  "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Vec"
                }
              },
              "required": [
                "at",
                "actorId",
                "target"
              ]
            }
          },
          "required": [
            "mode",
            "position",
            "velocity",
            "releasedAt"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "number"
              },
              "actorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "kind": {
                "enum": [
                  "release",
                  "catch",
                  "contact",
                  "failure"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "at",
              "actorId",
              "kind",
              "reason"
            ]
          },
          "maxItems": 128
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "trace": {
                "$ref": "https://rugby-player-model.local/schema/player-v1#/$defs/Trace"
              }
            },
            "required": [
              "id",
              "trace"
            ]
          },
          "maxItems": 32
        }
      },
      "required": [
        "version",
        "actors",
        "ball",
        "events",
        "decisions"
      ]
    }
  }
}
