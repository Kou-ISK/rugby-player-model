          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "score",
        "allowed",
        "reason"
      ]
    },
    "Trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensation": {
          "$ref": "#/$defs/Bundle"
        },
        "attention": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workingMemory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Belief"
          }
        },
        "longTermMemory": {
          "$ref": "#/$defs/Memory"
        },
        "beliefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Belief"
          }
        },
        "predictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entityId": {
                "type": "string",
                "minLength": 1
              },
              "basisObservedAt": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "$ref": "#/$defs/Vec"
              },
              "uncertaintyRadius": {
                "type": "number",
                "minimum": 0
              },
              "method": {
                "const": "last-observation"
              }
            },
            "required": [
              "entityId",
              "basisObservedAt",
              "uncertaintyRadius",
              "method"
            ]
          }
        },
        "evaluation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evaluation"
          }
        },
        "intention": {
          "$ref": "#/$defs/Evaluation"
        },
        "output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BodyCommand"
          }
        },
        "rulesVersion": {
          "type": "string",
          "minLength": 1
        },
        "modelRevision": {
          "enum": [
            "cognition-0.2",
            "cognition-0.3"
          ]
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uncertainThreat": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "informationValue": {
              "type": "number",
              "minimum": 0
            },
            "scanTarget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "headYaw": {
                  "type": "number",
                  "minimum": -2.4,
                  "maximum": 2.4
                },
                "observedAt": {
                  "type": "number",
                  "minimum": 0
                },
                "modality": {
                  "enum": [
                    "vision",
                    "audio"
                  ]
                }
              },
              "required": [
                "sourceId",
                "headYaw",
                "observedAt",
                "modality"
              ]
            }
          },
          "required": [
            "uncertainThreat",
            "informationValue"
          ]
        },
        "appliedRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "action": {
                "enum": [
                  "scan",
                  "hold",
                  "carry",
                  "pass",
                  "support"
                ]
              },
              "weight": {
                "type": "number"
              },
