            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "z"
          ]
        },
        "bearing": {
          "type": "number"
        },
        "cue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "currentConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "age": {
          "type": "number",
          "minimum": 0
        },
        "uncertaintyRadius": {
          "type": "number",
          "minimum": 0
        },
        "observerYaw": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "entityId",
        "kind",
        "relation",
        "modality",
        "observedAt",
        "confidence",
        "currentConfidence",
        "age",
