{
  "name": "rugby-player-model",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx tools/workbench/server/dev.ts",
    "bridge": "tsx tools/workbench/server/cli.ts",
    "spike": "tsx scripts/spike.ts",
    "model": "tsx tools/simulation/cli.ts",
    "samples": "tsx scripts/make-samples.ts",
    "manifest:check": "node scripts/reproducibility.mjs",
    "manifest:write": "node scripts/reproducibility.mjs --write",
    "test": "node --import tsx --test --test-concurrency=1 models/player/tests/*.test.ts tools/*/tests/*.test.ts tools/*/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:player && vite build tools/workbench --outDir ../../dist --emptyOutDir",
    "test:browser": "playwright test --config tools/workbench/playwright.config.ts",
    "check": "npm run manifest:check && npm run check:docs && npm run typecheck && npm test && npm run build && npm run check:boundaries",
    "build:player": "tsc -p models/player/tsconfig.build.json",
    "test:first-run": "node scripts/first-run-acceptance.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/three": "0.183.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "workspaces": [
    "models/player"
  ]
}
